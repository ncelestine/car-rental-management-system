@model IEnumerable<CarRentalManagementSystem.Models.Rental>

@{
    ViewData["Title"] = "My Rentals";
}

<h2>My Rentals</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info">
        You have not requested any rentals yet.
    </div>
    <p>
        <a asp-action="Browse" class="btn btn-primary">Browse Cars</a>
    </p>
}
else
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Requested</th>
                <th>Car</th>
                <th>Dates</th>
                <th>Total Cost</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.RequestedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (r.Car != null)
                        {
                            @($"{r.Car.Make} {r.Car.Model} ({r.Car.Year})")
                        }
                        else
                        {
                            <span class="text-muted">Car not found</span>
                        }
                    </td>
                    <td>@r.StartDate.ToString("yyyy-MM-dd") - @r.EndDate.ToString("yyyy-MM-dd")</td>
                    <td>$@r.TotalCost.ToString("0.00")</td>
                    <td>
                        @if (r.Status == "Approved")
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (r.Status == "Rejected")
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                        else if (r.Status == "Completed")
                        {
                            <span class="badge bg-secondary">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p>
        <a asp-action="Browse" class="btn btn-outline-primary">Browse More Cars</a>
    </p>
}
